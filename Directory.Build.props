<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningWave>latest</WarningWave>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- ManagePackageVersionsCentrally lives in Directory.Packages.props only. -->
    <Version>0.21.0.2</Version>
    <AssemblyVersion>0.21.0.2</AssemblyVersion>
    <FileVersion>0.21.0.2</FileVersion>
  </PropertyGroup>
</Project>
