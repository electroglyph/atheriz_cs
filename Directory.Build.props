<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningWave>latest</WarningWave>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- ManagePackageVersionsCentrally lives in Directory.Packages.props only. -->
    <Version>0.22.0.6</Version>
    <AssemblyVersion>0.22.0.6</AssemblyVersion>
    <FileVersion>0.22.0.6</FileVersion>
  </PropertyGroup>
</Project>
