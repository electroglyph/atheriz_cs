<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <!-- Full Evennia-derived verb table, copied verbatim from
         atheriz/objects/verb_conjugation/verbs.txt. Embedded in the assembly
         (the equivalent of Python's os.path.dirname(__file__)/verbs.txt) so
         identical builds always load the identical table regardless of the
         launch directory. Embedded only: no output-dir copy shadowing it. -->
    <EmbeddedResource Include="Objects/VerbConjugation/verbs.txt" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <!-- Direct ref (same version as EFCore.Sqlite's transitive dep) so saves can
         detect SQLITE_BUSY/SQLITE_LOCKED for bounded retry without reflection. -->
    <PackageReference Include="Microsoft.Data.Sqlite.Core" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <!-- Telnet wire engine (server sessions). The engine owns the protocol. -->
    <PackageReference Include="telnet_cs" />
    <!-- Compile-time hook map (HookName enum + Name/TryParseName/
         DispatchArgCounts) generated from the HookNames constants, so the
         three spellings cannot drift. Analyzer-only: never a runtime dep. -->
    <ProjectReference Include="..\Atheriz.HookGen\Atheriz.HookGen.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- The display version is baked into the assembly at compile time instead of
       being read from assembly metadata at runtime. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <BuildInfoFile>$(IntermediateOutputPath)BuildInfo.g.cs</BuildInfoFile>
    </PropertyGroup>
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <ItemGroup>
      <BuildInfoLines Include="// &lt;auto-generated/&gt;" />
      <BuildInfoLines Include="namespace Atheriz.Core%3B" />
      <BuildInfoLines Include="internal static class BuildInfo" />
      <BuildInfoLines Include="{" />
      <BuildInfoLines Include="    public const string Version = &quot;$(Version)&quot;%3B" />
      <BuildInfoLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(BuildInfoFile)" Lines="@(BuildInfoLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Remove="$(BuildInfoFile)" />
      <Compile Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

</Project>
