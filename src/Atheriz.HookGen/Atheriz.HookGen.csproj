<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Required by Roslyn 5.x (RS1036) for analyzer/generator projects; also
         turns on the extended analyzer ruleset for this project. -->
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
  </PropertyGroup>

  <ItemGroup>
    <!-- Roslyn for the compile-time hook map generator (version pinned in
         Directory.Packages.props). Analyzer-only: Core references this with
         ReferenceOutputAssembly=false, so it never ships as a runtime dep. -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

</Project>
